<?xml version="1.0" encoding="utf-8"?>
<!--
    Everything is backed up (exercises, sessions, settings) except the state of the rest timer, and
    the state of the sync: a restored device connects its Google account again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rest_timer.xml" />
        <exclude domain="file" path="muscuapp-sync.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rest_timer.xml" />
        <exclude domain="file" path="muscuapp-sync.json" />
    </device-transfer>
</data-extraction-rules>
